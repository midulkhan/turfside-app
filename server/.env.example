# Copy these into cPanel → Setup Node.js App → Environment variables (never commit real values).
NODE_ENV=production
PUBLIC_URL=https://api.turfsides.com
# Supabase → Connect → Session pooler (IPv4, persistent connections, works with advisory locks)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_POOL_MAX=5
# 48+ random characters each (openssl rand -base64 48)
JWT_SECRET=
PASS_SECRET=
OTP_SECRET=
CRON_SECRET=
# Optional: Upstash Redis (HTTPS). Without it an in-memory cache is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: Supabase Realtime for live slot updates in the app (public values)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
# SMS: console (dev only) | http (your SMS gateway)
SMS_PROVIDER=http
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_SENDER_ID=
# Payments: off | simulate (staging only) | sandbox | live
BKASH_MODE=off
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
SERVICE_FEE_POISHA=0

# Cloudflare R2 (photo uploads). Create an R2 API token with "Object Read & Write" on one bucket.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=turfsides-media
# Public read URL of the bucket: the r2.dev URL (testing) or a custom domain like https://cdn.turfsides.com
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
